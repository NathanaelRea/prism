#!/usr/bin/env python3
import os
import pathlib
import select
import signal
import sys
import termios
import time

from _common import log_event, reject, root

args = sys.argv[1:]
if args == ["--version"]:
    log_event("harness", args)
    print("prism-e2e-harness 1.0")
    raise SystemExit(0)
if not args or args[0] not in ("interactive", "headless") or len(args) > 2:
    reject("harness", args)

log_event("harness", args)
ready = root() / "state" / f"harness-{os.getpid()}.ready"
temporary = ready.with_suffix(".tmp")
temporary.write_text(f"cwd={os.getcwd()}\npid={os.getpid()}\n", encoding="utf-8")
os.replace(temporary, ready)
print(f"PRISM_E2E_HARNESS_READY cwd={os.getcwd()}", flush=True)
if os.isatty(sys.stdin.fileno()):
    attributes = termios.tcgetattr(sys.stdin.fileno())
    attributes[3] &= ~(termios.ICANON | termios.ECHO)
    termios.tcsetattr(sys.stdin.fileno(), termios.TCSANOW, attributes)

running = True

def stop(_signum, _frame):
    global running
    running = False

signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
while running:
    readable, _, _ = select.select([sys.stdin], [], [], 0.1)
    if not readable:
        continue
    data = os.read(sys.stdin.fileno(), 65536)
    if not data:
        time.sleep(0.05)
        continue
    text = data.decode("utf-8", errors="replace")
    log_event("harness-stdin", args, stdin=text)
