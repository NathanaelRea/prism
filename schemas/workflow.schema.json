{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prism.local/schemas/workflow.schema.json",
  "title": "Prism Prompt Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["step"],
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "max_agent_runs": { "type": "integer", "minimum": 1 }
      }
    },
    "step": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "trigger": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "context": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "harness": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "variant": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "required": ["prompt"] },
          { "required": ["trigger"] }
        ]
      }
    }
  }
}
