{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/NathanaelRea/prism/main/schemas/config/v1/global.schema.json",
  "title": "Prism Global Config V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version"],
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string" } },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "icon_style": { "enum": ["unicode", "nerd-font"] } }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre_pr": { "$ref": "#/$defs/stringList" },
        "pre_push": { "$ref": "#/$defs/stringList" },
        "review_fix": { "$ref": "#/$defs/stringList" }
      }
    },
    "auto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "merge": { "type": "boolean" },
        "cleanup_after_merge": { "type": "boolean" },
        "require_review_approval": { "type": "boolean" },
        "push_initial": { "type": "boolean" },
        "push_repairs": { "type": "boolean" },
        "review_wait_enabled": { "type": "boolean" },
        "review_reviewer_identities": { "$ref": "#/$defs/stringList" },
        "review_max_wait_seconds": { "type": "integer", "minimum": 0 },
        "review_poll_interval_seconds": { "type": "integer", "minimum": 1 },
        "review_continue_on_timeout": { "type": "boolean" },
        "ci_wait_enabled": { "type": "boolean" },
        "ci_max_wait_seconds": { "type": "integer", "minimum": 0 },
        "ci_poll_interval_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sidebar_width": { "type": "integer", "minimum": 20, "maximum": 120 }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "needs_input": { "type": "boolean" },
        "completed": { "type": "boolean" },
        "failed": { "type": "boolean" }
      }
    },
    "worktrees": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "columns": { "$ref": "#/$defs/stringList" } }
    },
    "tools": {
      "type": "object",
      "propertyNames": { "not": { "const": "opencode" } },
      "additionalProperties": { "type": "string" }
    },
    "remoteHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "enum": ["github", "gitlab", "forgejo"] },
        "web_url": { "type": "string", "pattern": "^https?://" },
        "api_url": { "type": "string", "pattern": "^https?://" },
        "credential_env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "allow_http": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "required": ["credential_env"] },
          "then": { "properties": { "provider": { "const": "forgejo" } } }
        },
        {
          "if": {
            "anyOf": [
              { "properties": { "web_url": { "pattern": "^http://" } }, "required": ["web_url"] },
              { "properties": { "api_url": { "pattern": "^http://" } }, "required": ["api_url"] }
            ]
          },
          "then": { "properties": { "allow_http": { "const": true } }, "required": ["allow_http"] }
        }
      ]
    },
    "remoteHosts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/remoteHost" }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": { "enum": ["opencode", "codex", "claude", "pi", "generic"] },
        "program": { "type": "string" },
        "arguments": { "$ref": "#/$defs/stringList" },
        "interactive_command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "interactive_prompt_transport": { "enum": ["argument", "stdin", "temp-file"] },
        "headless_command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "headless_prompt_transport": { "enum": ["argument", "stdin", "temp-file"] },
        "output_format": { "const": "text" },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "harnesses": {
      "type": "object",
      "properties": {
        "opencode": { "allOf": [{ "$ref": "#/$defs/harness" }, { "properties": { "adapter": { "const": "opencode" } } }] },
        "codex": { "allOf": [{ "$ref": "#/$defs/harness" }, { "properties": { "adapter": { "const": "codex" } } }] },
        "claude": { "allOf": [{ "$ref": "#/$defs/harness" }, { "properties": { "adapter": { "const": "claude" } } }] },
        "pi": { "allOf": [{ "$ref": "#/$defs/harness" }, { "properties": { "adapter": { "const": "pi" } } }] }
      },
      "additionalProperties": {
        "allOf": [
          { "$ref": "#/$defs/harness" },
          { "properties": { "adapter": { "const": "generic" } } }
        ]
      }
    },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "properties": {
    "config_version": { "const": 1 },
    "default_harness": { "type": "string" },
    "harnesses": { "$ref": "#/$defs/harnesses" },
    "default_base": { "type": "string" },
    "plan_dir": { "type": "string" },
    "review_packet_dir": { "type": "string" },
    "worktree_command": { "type": "string" },
    "opencode_port_base": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "opencode_port_span": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "opencode_shutdown_owned_servers": { "type": "boolean" },
    "opencode_plan_plugin": { "type": "boolean" },
    "escape_key": { "enum": ["esc-esc", "ctrl-space"] },
    "merge_method": { "enum": ["squash", "merge", "rebase"] },
    "ui": { "$ref": "#/$defs/ui" },
    "checks": { "$ref": "#/$defs/checks" },
    "auto": { "$ref": "#/$defs/auto" },
    "layout": { "$ref": "#/$defs/layout" },
    "notifications": { "$ref": "#/$defs/notifications" },
    "worktrees": { "$ref": "#/$defs/worktrees" },
    "tools": { "$ref": "#/$defs/tools" },
    "remote_hosts": { "$ref": "#/$defs/remoteHosts" },
    "prompt_templates": { "$ref": "#/$defs/stringMap" }
  }
}
